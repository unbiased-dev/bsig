{
  "name": "bsig",
  "version": "0.6.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unbiased-dev/bsig.git"
  },
  "main": "./runtime.js",
  "dependencies": {
    "@babel/core": "7.29.7",
    "@babel/plugin-transform-react-jsx": "7.29.7",
    "@babel/plugin-transform-typescript": "7.29.9"
  },
  "exports": {
    ".": {
      "types": "./runtime.d.ts",
      "import": "./runtime.js",
      "default": "./runtime.js"
    },
    "./plugin": {
      "types": "./plugin/bsig-jsx.d.ts",
      "import": "./plugin/bsig-jsx.js",
      "default": "./plugin/bsig-jsx.js"
    },
    "./jsx-runtime": {
      "types": "./jsx-runtime.d.ts",
      "import": "./jsx-runtime.js",
      "default": "./jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./jsx-runtime.d.ts",
      "import": "./jsx-runtime.js",
      "default": "./jsx-runtime.js"
    },
    "./bun-plugin": {
      "types": "./plugin/bun.d.ts",
      "import": "./plugin/bun.js",
      "default": "./plugin/bun.js"
    },
    "./router": {
      "types": "./router.d.ts",
      "import": "./router.js",
      "default": "./router.js"
    },
    "./auth": {
      "types": "./auth.d.ts",
      "import": "./auth.js",
      "default": "./auth.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "bsig-skill": "./skills/install.mjs",
    "bsig-router-skill": "./skills/install-router.mjs",
    "bsig-auth-skill": "./skills/install-auth.mjs"
  },
  "description": "Tiny signal-based reactive UI library with React-like JSX. Fine-grained updates, no virtual DOM.",
  "files": [
    "runtime.js",
    "runtime.d.ts",
    "router.js",
    "router.d.ts",
    "auth.js",
    "auth.d.ts",
    "jsx-runtime.js",
    "jsx-runtime.d.ts",
    "plugin/",
    "vendor/",
    "skills/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "homepage": "https://github.com/unbiased-dev/bsig",
  "license": "MIT",
  "scripts": {
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "test:ci": "bun test --coverage --reporter=junit --reporter-outfile=./junit.xml",
    "test:browser": "BUN_BSIG_BROWSER=1 bun test test/browser",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "sideEffects": false,
  "type": "module",
  "types": "./runtime.d.ts",
  "devDependencies": {
    "@happy-dom/global-registrator": "21.0.1",
    "@types/bun": "1.4.3",
    "happy-dom": "21.0.1",
    "typescript": "5.4.5"
  }
}
