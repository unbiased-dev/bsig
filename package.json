{
  "name": "bsig",
  "version": "0.4.0",
  "description": "Tiny signal-based reactive UI library with React-like JSX. Fine-grained updates, no virtual DOM.",
  "type": "module",
  "bin": {
    "bsig-skill": "./skills/install.mjs"
  },
  "main": "./runtime.js",
  "types": "./runtime.d.ts",
  "exports": {
    ".": {
      "types": "./runtime.d.ts",
      "import": "./runtime.js",
      "default": "./runtime.js"
    },
    "./plugin": {
      "types": "./plugin/bsig-jsx.d.ts",
      "import": "./plugin/bsig-jsx.js",
      "default": "./plugin/bsig-jsx.js"
    },
    "./jsx-runtime": {
      "types": "./jsx-runtime.d.ts",
      "import": "./jsx-runtime.js",
      "default": "./jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./jsx-runtime.d.ts",
      "import": "./jsx-runtime.js",
      "default": "./jsx-runtime.js"
    },
    "./bun-plugin": {
      "types": "./plugin/bun.d.ts",
      "import": "./plugin/bun.js",
      "default": "./plugin/bun.js"
    },
    "./router": {
      "types": "./router.d.ts",
      "import": "./router.js",
      "default": "./router.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "runtime.js",
    "runtime.d.ts",
    "router.js",
    "router.d.ts",
    "jsx-runtime.js",
    "jsx-runtime.d.ts",
    "plugin/",
    "vendor/",
    "skills/",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@babel/core": "7.29.7",
    "@babel/plugin-transform-react-jsx": "7.29.7",
    "@babel/plugin-transform-typescript": "7.29.9"
  },
  "devDependencies": {
    "esbuild": "0.21.5",
    "jsdom": "24.1.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unbiased-dev/bsig.git"
  },
  "homepage": "https://github.com/unbiased-dev/bsig",
  "license": "MIT"
}
